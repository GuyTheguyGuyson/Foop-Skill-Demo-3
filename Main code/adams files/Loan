package SET PACKAGE NAME

public class Loan {
    
    //Instance variables 
    Member member; 
    Book book;
    
   
    public Loan(Member member, Book book){
        
        
        if (!book.isAvailable()) { 
            throw new IllegalStateException("Book is not available."); 
        } 
  

        if (!member.canBorrow()) { 
            throw new IllegalStateException("Borrow limit reached."); 
        } 

        //Initialise member  
        this.member = member;
        
       // Initialise book 
       this.book = book;
       
        //Set book availability to false   
        book.setAvailable(false);
        
       //Increment member borrowed books 
       member.incrementBorrowedBooks();
        
    }//end method

    public void getLoanDetails(){

        System.out.println("Loan details...");
        System.out.println("Member name: "+member.getName());
        System.out.println("Book name: "+book.getTitle());
        System.out.println("Book ID: "+book.getIsbn());


    
    }//end method
    
    
    
}//end class

